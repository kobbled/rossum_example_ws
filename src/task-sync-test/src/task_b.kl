PROGRAM task_b
%NOBUSYLAMP
%COMMENT = ''
%NOLOCKGROUP
%TPMOTION
%NOPAUSE = ERROR + TPENABLE + COMMAND
%NOABORT = ERROR + COMMAND

%include math.klt


--USER DEFINITIONS

%define USERFRAME 9
%define TOOLFRAME 3
%define SPEED_REGISTER 156
%define POSEREG_MOTION_REG 80

%define POLYGON_RADIUS 50
%define POLYGON_POINTS 5

%mode push
%mode string QQQ "`" "`" "\\"
%define set_origin `

-- *******USER IMPORTANT***********
-- Change origin to reflect robot cell
-- you are building
-- ******************

origin.x = POLYGON_RADIUS ; origin.y = POLYGON_RADIUS; origin.z = 50;
origin.w = 180 ; origin.p = 0; origin.r = 0;
CNV_STR_CONF('F U T, 0, 0, 0', origin.config_data, status)

`
%mode pop

--END OF USER DEFINITIONS

VAR 
  motion_ctrl FROM main_task : INTEGER
  work_path  : PATH
  status : INTEGER

%from registers.klh %import set_real
%from pose.klh %import set_userframe, set_toolframe
%from math.klh %import translate, rotz

ROUTINE clear_pth(p : PATH)
  VAR
    i, status : INTEGER
  BEGIN
    i = PATH_LEN(p)
    WHILE PATH_LEN(p) > 0 DO
		  DELETE_NODE(p,i,status)
      i = i - 1
	  ENDWHILE
  END clear_pth

ROUTINE draw_hexagon(radius : REAL; verticies : INTEGER; origin : XYZWPR; out_poly : PATH)
  VAR 
    i, pthlen : INTEGER
    status : INTEGER
    ang : REAL
    p : XYZWPR
    trans : VECTOR
    vert : VECTOR
    poly_count : INTEGER
  BEGIN
    pthlen = 1
    --make radius vector
    trans.x = 0 ; trans.y = radius ; trans.z = 0 ;

    FOR i=0 TO (verticies-1) DO
      ang = (i*2*M_PI/verticies)*M_RAD2DEG
      p = math__rotz(math__translate(math__rotz((origin), ang), trans), -ang)
      vert.x = p.x ; vert.y = p.y ; vert.z = p.z ;

      APPEND_NODE(out_poly, status)
      out_poly[pthlen].node_pos = p
      --increment path length as it may not be tha same as i+1
      pthlen = pthlen + 1
    ENDFOR
  END draw_hexagon

ROUTINE do_work
  VAR
    origin : XYZWPR
    time_out : BOOLEAN
    i : INTEGER
  BEGIN
    WRITE TPDISPLAY(CR,'starting hexagon path.')
    PEND_SEMA(motion_ctrl, -1, time_out)
    LOCK_GROUP(1,status)

    --set frames
    pose__set_userframe(USERFRAME, 1)
    pose__set_toolframe(TOOLFRAME, 1)

    --initialize origin
    -- *******USER IMPORTANT***********
    -- Change origin to reflect robot cell
    -- you are building
    -- ******************
    set_origin

    --set speed
    registers__set_real(SPEED_REGISTER, 50)

    --generate hexagon path
    --make pentagon
    draw_hexagon(POLYGON_RADIUS, POLYGON_POINTS, origin, work_path)
    
    --loop through path linearly moving robot to each position
    FOR i=1 TO PATH_LEN(work_path) DO 
      SET_POS_REG(POSEREG_MOTION_REG, (work_path[i].node_pos), status)
      WRITE TPDISPLAY(CR,'Moving to position:', i, ' of hexagon path...')
      CALL_PROG('move_to_pose', 0)
    ENDFOR

    --got back to first position
    SET_POS_REG(POSEREG_MOTION_REG, (work_path[1].node_pos), status)
    WRITE TPDISPLAY(CR,'Moving to position:', 1, ' of hexagon path...')
    CALL_PROG('move_to_pose', 0)


    UNLOCK_GROUP(1, status)
    POST_SEMA(motion_ctrl)
    WRITE TPDISPLAY(CR,'hexagon path finished')
  END do_work

BEGIN
  SET_CURSOR(TPFUNC, 1, 10, status)
  WRITE TPFUNC('WORK', CR)
  --clear path before writing to it
  clear_pth(work_path)

  WAIT FOR TPIN[131]+ -- F2 button
  do_work
END task_b